{
	"name": "df_silver_demanda_paradas",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bsql_demanda_paradas",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_demanda_paradas_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(FechaServicio = iif(regexMatch(trim(replace(replace(FechaServicio, 'N\\'', ''), '\\'', '')), '^CONVERT.*'), regexExtract(replace(replace(FechaServicio, 'N\\'', ''), '\\'', ''), '(?i)CONVERT\\\\s*\\\\(\\\\s*DATE\\\\s*,\\\\s*N?\\'([^\\']+)\\'\\\\s*,\\\\s*23\\\\s*\\\\)', 1), iif(regexMatch(trim(replace(replace(FechaServicio, 'N\\'', ''), '\\'', '')), '^\\\\d+$'), toString(addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(replace(replace(FechaServicio, 'N\\'', ''), '\\'', '')))), 'yyyy-MM-dd'), iif(regexMatch(trim(replace(replace(FechaServicio, 'N\\'', ''), '\\'', '')), '^\\\\d{2}/\\\\d{2}/\\\\d{4}$'), toString(toDate(trim(replace(replace(FechaServicio, 'N\\'', ''), '\\'', '')), 'dd/MM/yyyy'), 'yyyy-MM-dd'), trim(replace(replace(FechaServicio, 'N\\'', ''), '\\'', '')))))) ~> derivedColumn1",
				"derivedColumn1 derive(AnioFuente = iif(regexMatch(trim(AnioFuente), '^\\\\d{4}$'), trim(AnioFuente), iif(regexMatch(FechaServicio, '^\\\\d{4}-'), regexExtract(FechaServicio, '^(\\\\d{4})-', 1), toString(null()))),",
				"          RutaHistoricaId = iif(upper(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', ''))) == 'RH-07-NEW', 'RH-07', iif(regexMatch(upper(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', ''))), '^RH?-?\\\\d{1,2}(-[SN])?$'), concat('RH-', lpad(regexExtract(upper(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', ''))), 'RH?-?(\\\\d{1,2})', 1), 2, '0'), coalesce(regexExtract(upper(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', ''))), '(RH?-?\\\\d{1,2})(-[SN])$', 2), '')), iif(regexMatch(upper(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', ''))), '^RUTA\\\\s+\\\\d{1,2}$'), concat('RH-', lpad(regexExtract(upper(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', ''))), 'RUTA\\\\s+(\\\\d{1,2})', 1), 2, '0')), iif(regexMatch(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', '')), '^\\\\d{1,2}$'), concat('RH-', lpad(trim(replace(replace(RutaHistoricaId, 'N\\'', ''), '\\'', '')), 2, '0')), toString(null()))))),",
				"          ParadaHistoricaId = iif(upper(trim(replace(replace(ParadaHistoricaId, 'N\\'', ''), '\\'', ''))) == 'P220-MC-NEW', 'P220', iif(regexMatch(upper(trim(replace(replace(ParadaHistoricaId, 'N\\'', ''), '\\'', ''))), '^P\\\\d{3}$'), upper(trim(replace(replace(ParadaHistoricaId, 'N\\'', ''), '\\'', ''))), toString(null()))),",
				"          Franja = trim(replace(replace(Franja, 'N\\'', ''), '\\'', '')),",
				"          Metodo = iif(in(array('VALIDACION_TARJETA', 'CONTEO_MANUAL', 'SENSOR', 'MEDIDO', 'NO_MEDIDO', 'ESTIMACION'), upper(trim(replace(replace(Metodo, 'N\\'', ''), '\\'', '')))), upper(trim(replace(replace(Metodo, 'N\\'', ''), '\\'', ''))), toString(null()))) ~> derivedColumn2",
				"derivedColumn2 derive(DemandaId = iif(isNull(DemandaId) || trim(replace(replace(DemandaId, 'N\\'', ''), '\\'', '')) == '', concat('DM-', toString(AnioFuente), '-', regexReplace(regexReplace(RutaHistoricaId, '-', ''), '\\\\s', ''), '-', lpad(regexReplace(ParadaHistoricaId, 'P', ''), 3, '0'), '-', regexReplace(FechaServicio, '-', '')), iif(regexMatch(upper(trim(replace(replace(DemandaId, 'N\\'', ''), '\\'', ''))), '^DM-\\\\d{4}-\\\\d{5}$'), upper(trim(replace(replace(DemandaId, 'N\\'', ''), '\\'', ''))), toString(null()))),",
				"          ValidacionesTarjeta = iif(regexMatch(trim(replace(replace(ValidacionesTarjeta, 'N\\'', ''), '\\'', '')), '^\\\\d+$'), trim(replace(replace(ValidacionesTarjeta, 'N\\'', ''), '\\'', '')), '0'),",
				"          Descensos = iif(regexMatch(trim(replace(replace(Descensos, 'N\\'', ''), '\\'', '')), '^\\\\d+$'), trim(replace(replace(Descensos, 'N\\'', ''), '\\'', '')), '0'),",
				"          DemandaNoAtendida = iif(regexMatch(trim(replace(replace(DemandaNoAtendida, 'N\\'', ''), '\\'', '')), '^\\\\d+$'), trim(replace(replace(DemandaNoAtendida, 'N\\'', ''), '\\'', '')), '0')) ~> derivedColumn3",
				"derivedColumn3 sink(allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          DemandaId as string,",
				"          FechaServicio as string,",
				"          RutaHistoricaId as string,",
				"          ParadaHistoricaId as string,",
				"          Franja as string,",
				"          ValidacionesTarjeta as string,",
				"          Descensos as string,",
				"          DemandaNoAtendida as string,",
				"          Metodo as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          DemandaId,",
				"          FechaServicio,",
				"          RutaHistoricaId,",
				"          ParadaHistoricaId,",
				"          Franja,",
				"          ValidacionesTarjeta,",
				"          Descensos,",
				"          DemandaNoAtendida,",
				"          Metodo",
				"     )) ~> sink1"
			]
		}
	}
}
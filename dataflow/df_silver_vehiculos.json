{
	"name": "df_silver_vehiculos",
	"properties": {
		"folder": {
			"name": "silver"
		},
		"type": "MappingDataFlow",
		"typeProperties": {
			"sources": [
				{
					"dataset": {
						"referenceName": "dw_bsql_vehiculos",
						"type": "DatasetReference"
					},
					"name": "source1"
				}
			],
			"sinks": [
				{
					"dataset": {
						"referenceName": "dw_silver_vechiculos_sql",
						"type": "DatasetReference"
					},
					"name": "sink1"
				}
			],
			"transformations": [
				{
					"name": "derivedColumn1"
				},
				{
					"name": "derivedColumn2"
				},
				{
					"name": "derivedColumn3"
				},
				{
					"name": "aggregate1"
				}
			],
			"scriptLines": [
				"source(output(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     allowSchemaDrift: true,",
				"     validateSchema: false,",
				"     isolationLevel: 'READ_UNCOMMITTED',",
				"     format: 'table') ~> source1",
				"source1 derive(VehiculoId = iif(isNull(toString(byName('VehiculoId'))) || trim(toString(byName('VehiculoId'))) == '', toString(byName('nro_bus')), toString(byName('VehiculoId'))),",
				"          Placa = iif(isNull(toString(byName('Placa'))) || trim(toString(byName('Placa'))) == '', toString(byName('placa')), toString(byName('Placa'))),",
				"          TipoVehiculo = iif(isNull(toString(byName('TipoVehiculo'))) || trim(toString(byName('TipoVehiculo'))) == '', toString(byName('tipo_bus')), toString(byName('TipoVehiculo'))),",
				"          CapacidadEfectiva = iif(isNull(toString(byName('CapacidadEfectiva'))) || trim(toString(byName('CapacidadEfectiva'))) == '', toString(byName('capacidad')), toString(byName('CapacidadEfectiva'))),",
				"          VigenciaDesde = iif(isNull(toString(byName('VigenciaDesde'))) || trim(toString(byName('VigenciaDesde'))) == '', toString(byName('fecha_desde')), toString(byName('VigenciaDesde'))),",
				"          VigenciaHasta = iif(isNull(toString(byName('VigenciaHasta'))) || trim(toString(byName('VigenciaHasta'))) == '', toString(byName('fecha_hasta')), toString(byName('VigenciaHasta'))),",
				"          Estado = iif(isNull(toString(byName('Estado'))) || trim(toString(byName('Estado'))) == '', toString(byName('estado')), toString(byName('Estado')))) ~> derivedColumn1",
				"derivedColumn1 derive(VehiculoId = iif(isNull(VehiculoId) || trim(VehiculoId) == '',",
				"                  iif(regexMatch(upper(Placa), `^[A-Z]+-[0-9]{1,3}$`), concat('V-', lpad(regexExtract(upper(Placa), `([0-9]{1,3})$`, 1), 3, '0')), VehiculoId),",
				"                  iif(regexMatch(upper(trim(VehiculoId)), `^V-?[0-9]{1,3}$`), concat('V-', lpad(regexExtract(upper(trim(VehiculoId)), `([0-9]{1,3})$`, 1), 3, '0')),",
				"                      iif(regexMatch(trim(VehiculoId), `^[0-9]{1,3}$`), concat('V-', lpad(trim(VehiculoId), 3, '0')), upper(trim(VehiculoId))))),",
				"          TipoVehiculo = upper(trim(TipoVehiculo)),",
				"          Estado = upper(trim(Estado)),",
				"          VigenciaDesde = iif(isNull(VigenciaDesde) || trim(VigenciaDesde) == '', toString(null()),",
				"  iif(regexMatch(trim(VigenciaDesde), `^[0-9]{1,5}$`),",
				"      toString(addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(VigenciaDesde))), 'yyyy-MM-dd'),",
				"      iif(regexMatch(trim(VigenciaDesde), `^[0-9]{2}/[0-9]{2}/[0-9]{4}$`),",
				"          toString(toDate(trim(VigenciaDesde), 'dd/MM/yyyy'), 'yyyy-MM-dd'),",
				"          iif(regexMatch(trim(VigenciaDesde), `[0-9]{4}-[0-9]{2}-[0-9]{2}`),",
				"              regexExtract(trim(VigenciaDesde), `([0-9]{4}-[0-9]{2}-[0-9]{2})`, 1),",
				"              trim(VigenciaDesde))))),",
				"          VigenciaHasta = iif(isNull(VigenciaHasta) || trim(VigenciaHasta) == '', toString(null()),",
				"  iif(regexMatch(trim(VigenciaHasta), `^[0-9]{1,5}$`),",
				"      toString(addDays(toDate('1899-12-30', 'yyyy-MM-dd'), toInteger(trim(VigenciaHasta))), 'yyyy-MM-dd'),",
				"      iif(regexMatch(trim(VigenciaHasta), `^[0-9]{2}/[0-9]{2}/[0-9]{4}$`),",
				"          toString(toDate(trim(VigenciaHasta), 'dd/MM/yyyy'), 'yyyy-MM-dd'),",
				"          iif(regexMatch(trim(VigenciaHasta), `[0-9]{4}-[0-9]{2}-[0-9]{2}`),",
				"              regexExtract(trim(VigenciaHasta), `([0-9]{4}-[0-9]{2}-[0-9]{2})`, 1),",
				"              trim(VigenciaHasta)))))) ~> derivedColumn2",
				"derivedColumn2 derive(Placa = iif(isNull(Placa) || trim(Placa) == '',",
				"             iif(regexMatch(VehiculoId, `^V-[0-9]{3}$`), concat('ABC-', regexExtract(VehiculoId, `^V-([0-9]{3})$`, 1)), Placa), upper(trim(Placa))),",
				"          AnioFuente = iif(isNull(toString(byName('AnioFuente'))) || trim(toString(byName('AnioFuente'))) == '', toShort(2025),",
				"                  iif(regexMatch(trim(toString(byName('AnioFuente'))), `^[0-9]{4}$`), toShort(toString(byName('AnioFuente'))), toShort(2025))),",
				"          CapacidadEfectiva = iif(isNull(CapacidadEfectiva) || trim(CapacidadEfectiva) == '',",
				"      iif(TipoVehiculo == 'ARTICULADO', 80, iif(TipoVehiculo == 'ESTANDAR', 45, toInteger(null()))),",
				"      iif(regexMatch(trim(CapacidadEfectiva), `^[0-9]+$`), toInteger(trim(CapacidadEfectiva)), toInteger(null()))),",
				"          VigenciaDesde = toDate(VigenciaDesde, 'yyyy-MM-dd'),",
				"          VigenciaHasta = toDate(VigenciaHasta, 'yyyy-MM-dd')) ~> derivedColumn3",
				"derivedColumn3 aggregate(groupBy(AnioFuente,",
				"          VehiculoId),",
				"     each(match(name!='AnioFuente'&&name!='VehiculoId'), $$ = first($$))) ~> aggregate1",
				"aggregate1 sink(allowSchemaDrift: false,",
				"     validateSchema: false,",
				"     input(",
				"          AnioFuente as string,",
				"          VehiculoId as string,",
				"          Placa as string,",
				"          TipoVehiculo as string,",
				"          CapacidadEfectiva as string,",
				"          VigenciaDesde as string,",
				"          VigenciaHasta as string,",
				"          Estado as string",
				"     ),",
				"     deletable:false,",
				"     insertable:true,",
				"     updateable:false,",
				"     upsertable:false,",
				"     format: 'table',",
				"     skipDuplicateMapInputs: true,",
				"     skipDuplicateMapOutputs: true,",
				"     errorHandlingOption: 'stopOnFirstError',",
				"     mapColumn(",
				"          AnioFuente,",
				"          VehiculoId,",
				"          Placa,",
				"          TipoVehiculo,",
				"          CapacidadEfectiva,",
				"          VigenciaDesde,",
				"          VigenciaHasta,",
				"          Estado",
				"     )) ~> sink1"
			]
		}
	}
}